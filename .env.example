APP_ENV=local
APP_NAME=SignalFlow AI
API_V1_PREFIX=/api/v1
SECRET_KEY=unsafe-local-only-change-me
WEBHOOK_SIGNING_SECRET=unsafe-local-webhook-secret
DATABASE_URL=postgresql+psycopg://signalflow_runtime:signalflow_runtime_dev_only@db:5432/signalflow
APP_DB_PASSWORD=signalflow_runtime_dev_only
MIGRATOR_DB_PASSWORD=signalflow_migrator_dev_only
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Required in production; must match the trusted identity provider token claims
JWT_ISSUER=
JWT_AUDIENCE=

# Optional integrations (never commit real credentials)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_DEMO_TENANT_ID=
# Native HubSpot webhook verification (required to accept production HubSpot webhooks)
HUBSPOT_CLIENT_SECRET=
HUBSPOT_WEBHOOK_TENANT_ID=
MAX_REQUEST_BODY_BYTES=1048576

# Frontend build-time demo configuration (local development only)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_TENANT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
